{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reuse-evidence.skill-evidence.event.v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "recorded_at",
    "operator_workflow",
    "target",
    "top_level_session_id",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "enum": [
        "use_recorded",
        "review_started",
        "review_disposition",
        "validation_completed",
        "change_landed",
        "decontamination_started",
        "decontamination_completed"
      ]
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "operator_workflow": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["name", "repo_relative_path", "content_hash", "repo_head"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repo_relative_path": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "minLength": 1 },
        "repo_head": { "type": "string", "minLength": 1 }
      }
    },
    "top_level_session_id": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "use_recorded" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "qualifying_use",
              "retrospective",
              "task_label",
              "task_fingerprint",
              "outcome",
              "symptom_key",
              "expected",
              "observed",
              "consequence",
              "workaround_taken",
              "evidence_refs",
              "same_run_group"
            ],
            "properties": {
              "qualifying_use": { "const": true },
              "retrospective": { "type": "boolean" },
              "task_label": { "type": "string", "minLength": 1 },
              "task_fingerprint": { "type": "string", "minLength": 1 },
              "outcome": {
                "enum": [
                  "clean",
                  "friction",
                  "material_failure",
                  "severe_incident"
                ]
              },
              "symptom_key": {
                "type": ["string", "null"],
                "enum": [
                  "triggering",
                  "execution",
                  "output",
                  "state",
                  "tool-compatibility",
                  "coordination",
                  "cost",
                  "unknown",
                  null
                ]
              },
              "expected": { "type": ["string", "null"] },
              "observed": { "type": ["string", "null"] },
              "consequence": { "type": ["string", "null"] },
              "workaround_taken": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "run_condition": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "same_run_group": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "outcome": { "const": "clean" } },
                  "required": ["outcome"]
                },
                "then": {
                  "properties": {
                    "symptom_key": { "const": null },
                    "expected": { "const": null },
                    "observed": { "const": null },
                    "consequence": { "const": null },
                    "workaround_taken": { "const": null },
                    "run_condition": { "const": null }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "friction",
                        "material_failure",
                        "severe_incident"
                      ]
                    }
                  },
                  "required": ["outcome"]
                },
                "then": {
                  "properties": {
                    "symptom_key": {
                      "enum": [
                        "triggering",
                        "execution",
                        "output",
                        "state",
                        "tool-compatibility",
                        "coordination",
                        "cost",
                        "unknown"
                      ]
                    },
                    "expected": { "type": "string", "minLength": 1 },
                    "observed": { "type": "string", "minLength": 1 },
                    "consequence": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "if": {
                  "properties": { "retrospective": { "const": true } },
                  "required": ["retrospective"]
                },
                "then": {
                  "properties": {
                    "evidence_refs": { "minItems": 1 }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "review_disposition" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["review_id", "disposition", "adjudicated_event_ids"],
            "properties": {
              "review_id": { "type": "string", "minLength": 1 },
              "disposition": {
                "enum": [
                  "resolved_by_change",
                  "closed_no_skill_defect",
                  "outside_target",
                  "insufficient_independence",
                  "monitor_for_recurrence",
                  "superseded_by_target_version",
                  "candidate_rejected_validation",
                  "blocked_no_valid_test"
                ]
              },
              "adjudicated_event_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "instrument_limited_event_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "description": "Subset of adjudicated_event_ids this review could not decide: either no trial could express the mechanism those events record, or the acceptance gate grades outcome while their evidence bears no outcome claim. Asserts nothing about whether the mechanism reproduced. Omitted when the review decided everything it covered, which is what every close written before this key existed asserts."
              },
              "constraint_provenance": {
                "type": "array",
                "minItems": 1,
                "description": "Generated whole-field copies cited as the recorded ground for binding constraints behind instrument-limited coverage. They identify source text and do not assert entailment. Omitted means no checked constraint provenance was recorded; it does not negate an instrument-limited claim and includes every historical close that predates this key.",
                "items": {
                  "type": "object",
                  "required": ["constraint_label", "event_id", "field", "field_value"],
                  "properties": {
                    "constraint_label": { "type": "string", "minLength": 1 },
                    "event_id": { "type": "string", "minLength": 1 },
                    "field": {
                      "enum": [
                        "run_condition",
                        "observed",
                        "consequence",
                        "workaround_taken"
                      ]
                    },
                    "field_value": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "external_owners": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["event_id", "kind", "reference"],
                  "properties": {
                    "event_id": { "type": "string", "minLength": 1 },
                    "kind": {
                      "enum": [
                        "skill",
                        "contract",
                        "tool",
                        "environment",
                        "model_limitation",
                        "user_instruction"
                      ]
                    },
                    "reference": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "description": "Positive external owner recorded per concluded event by an outside_target close. Omitted when no owner was recorded, including every close written before this key existed."
              },
              "trial_count": {
                "type": "integer",
                "minimum": 1,
                "description": "Caller-asserted validation trial count. Omitted when no count was recorded for this close."
              },
              "artifacts_path": {
                "type": "string",
                "minLength": 1,
                "description": "Caller-asserted path to retained validation artifacts. Omitted when no path was recorded for this close."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "review_started",
              "validation_completed",
              "change_landed",
              "review_disposition"
            ]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["review_id"],
            "properties": {
              "review_id": { "type": "string", "minLength": 1 },
              "operating_skill_hash": {
                "type": "string",
                "minLength": 1,
                "description": "Content hash computed from the operating Skill Evolution package when this lifecycle event was written. Optional only for compatibility with history written before unconditional identity recording; absence never means the package matched the one operating now."
              },
              "operating_package_matches_shipped": {
                "type": "boolean",
                "description": "Whether the installed Skill Evolution package matched the copy this crate rendered for the consumer when this lifecycle event was written. Computed by the crate, never asserted by the caller. Optional only for compatibility with history written before package comparison; absence means unknown, not false."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "review_started",
              "validation_completed",
              "change_landed",
              "decontamination_started",
              "decontamination_completed"
            ]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["review_id"],
            "properties": {
              "review_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
